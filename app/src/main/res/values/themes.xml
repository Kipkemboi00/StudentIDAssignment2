<resources>
    <style name="Base.Theme.StudentIDAssignment2" parent="Theme.Material3.Light.NoActionBar">
        <item name="colorPrimary">@color/primary</item>
        <item name="colorOnPrimary">@color/on_primary</item>
        <item name="colorSecondary">@color/secondary</item>
        <item name="colorOnSecondary">@color/on_primary</item>
        <item name="colorSurface">@color/surface</item>
        <item name="colorOnSurface">@color/on_surface</item>
        <item name="colorSurfaceVariant">@color/accent_surface</item>
        <item name="colorOnSurfaceVariant">@color/muted</item>
        <item name="colorOutline">@color/outline</item>
        <item name="colorError">@color/error</item>
        <item name="android:colorBackground">@color/background</item>
        <item name="android:statusBarColor">@color/background</item>
        <item name="android:navigationBarColor">@color/primary</item>
        <item name="android:windowLightStatusBar">true</item>
        <item name="textInputStyle">@style/Widget.Collections.TextInput</item>
        <item name="materialButtonStyle">@style/Widget.Collections.Button</item>
    </style>
    <style name="Theme.StudentIDAssignment2" parent="Base.Theme.StudentIDAssignment2" />
    <style name="Text.Caption" parent="TextAppearance.Material3.LabelMedium">
        <item name="android:fontFamily">sans-serif-medium</item>
        <item name="android:textColor">@color/muted</item>
        <item name="android:textSize">12sp</item>
        <item name="android:letterSpacing">0.08</item>
    </style>
    <style name="Text.Heading" parent="TextAppearance.Material3.HeadlineLarge">
        <item name="fontFamily">serif</item>
        <item name="android:fontFamily">serif</item>
        <item name="android:textColor">@color/on_surface</item>
        <item name="android:textStyle">normal</item>
        <item name="android:textSize">36sp</item>
        <item name="android:letterSpacing">-0.025</item>
    </style>
    <style name="Text.Toolbar" parent="TextAppearance.Material3.TitleLarge">
        <item name="fontFamily">serif</item>
        <item name="android:fontFamily">serif</item>
        <item name="android:textColor">@color/on_surface</item>
        <item name="android:textSize">24sp</item>
    </style>
    <style name="Text.Body" parent="TextAppearance.Material3.BodyLarge">
        <item name="android:textColor">@color/muted</item>
        <item name="android:lineSpacingExtra">3dp</item>
    </style>
    <style name="Widget.Collections.TextInput" parent="Widget.Material3.TextInputLayout.OutlinedBox">
        <item name="boxCornerRadiusTopStart">14dp</item>
        <item name="boxCornerRadiusTopEnd">14dp</item>
        <item name="boxCornerRadiusBottomStart">14dp</item>
        <item name="boxCornerRadiusBottomEnd">14dp</item>
        <item name="boxBackgroundColor">@color/surface</item>
        <item name="boxStrokeColor">@color/input_stroke</item>
    </style>
    <style name="Widget.Collections.Button" parent="Widget.Material3.Button">
        <item name="cornerRadius">28dp</item>
        <item name="android:textAllCaps">false</item>
        <item name="android:fontFamily">sans-serif-medium</item>
        <item name="android:textSize">16sp</item>
    </style>
</resources>
