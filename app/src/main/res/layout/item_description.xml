<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" android:paddingBottom="24dp">
    <TextView android:id="@+id/label" android:layout_width="match_parent" android:layout_height="wrap_content"
        android:textAppearance="@style/Text.Heading" android:textSize="25sp" />
    <TextView android:id="@+id/value" android:layout_width="match_parent" android:layout_height="wrap_content"
        android:layout_marginTop="12dp" android:textSize="17sp" android:lineSpacingExtra="7dp"
        android:textColor="@color/on_surface" android:textIsSelectable="true" />
</LinearLayout>
