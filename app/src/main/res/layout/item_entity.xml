<com.google.android.material.card.MaterialCardView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginHorizontal="4dp"
    android:layout_marginBottom="16dp" android:clickable="true" android:focusable="true"
    android:foreground="?attr/selectableItemBackground" app:cardBackgroundColor="@color/surface"
    app:cardCornerRadius="22dp" app:cardElevation="0dp" app:strokeWidth="0dp">
    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
        android:padding="22dp" android:orientation="vertical">
        <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:gravity="center_vertical">
            <TextView android:id="@+id/number" android:layout_width="44dp" android:layout_height="44dp"
                android:gravity="center" android:background="@drawable/bg_accent" android:fontFamily="serif"
                android:textColor="@color/primary" android:textSize="22sp" android:importantForAccessibility="no" />
            <TextView android:id="@+id/kind" android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1"
                android:layout_marginStart="14dp" android:textAppearance="@style/Text.Caption" android:textAllCaps="true"
                android:maxLines="1" android:ellipsize="end" />
            <ImageView android:layout_width="24dp" android:layout_height="24dp" android:src="@drawable/ic_collection"
                app:tint="@color/muted" android:importantForAccessibility="no" />
        </LinearLayout>
        <TextView android:id="@+id/title" android:layout_width="match_parent" android:layout_height="wrap_content"
            android:layout_marginTop="18dp" android:textAppearance="@style/Text.Heading" android:textSize="27sp"
            android:maxLines="2" android:ellipsize="end" />
        <TextView android:id="@+id/summary" android:layout_width="match_parent" android:layout_height="wrap_content"
            android:layout_marginTop="10dp" android:textAppearance="?attr/textAppearanceBodyMedium"
            android:textColor="@color/muted" android:lineSpacingExtra="5dp" android:maxLines="6" android:ellipsize="end" />
        <View android:layout_width="match_parent" android:layout_height="1dp" android:layout_marginTop="20dp" android:background="@color/outline" />
        <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
            android:layout_marginTop="14dp" android:gravity="center_vertical">
            <TextView android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1"
                android:text="@string/view_details" android:fontFamily="sans-serif-medium" android:textSize="14sp" android:textColor="@color/primary" />
            <ImageView android:layout_width="32dp" android:layout_height="32dp" android:padding="7dp"
                android:src="@drawable/ic_arrow_forward" android:background="@drawable/bg_accent" app:tint="@color/primary"
                android:importantForAccessibility="no" />
        </LinearLayout>
    </LinearLayout>
</com.google.android.material.card.MaterialCardView>
