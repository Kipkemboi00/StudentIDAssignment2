<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent" android:layout_height="match_parent" android:orientation="vertical">
    <com.google.android.material.appbar.MaterialToolbar android:id="@+id/toolbar"
        android:layout_width="match_parent" android:layout_height="?attr/actionBarSize"
        android:background="@color/background" app:titleTextAppearance="@style/Text.Toolbar"
        app:titleTextColor="@color/on_surface" app:navigationIconTint="@color/on_surface" />
    <androidx.fragment.app.FragmentContainerView android:id="@+id/fragment_container"
        android:layout_width="match_parent" android:layout_height="0dp" android:layout_weight="1" />
</LinearLayout>
